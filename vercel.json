{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/warehouses/:id", "destination": "/api/warehouses?id=:id" },
    { "source": "/api/business-units/:id", "destination": "/api/business-units?id=:id" },
    { "source": "/api/organisations/:id", "destination": "/api/organisations?id=:id" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
