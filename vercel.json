{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/:resource/:id", "destination": "/api/index?resource=:resource&id=:id" },
    { "source": "/api/:resource",     "destination": "/api/index?resource=:resource" },
    { "source": "/((?!api/).*)",      "destination": "/index.html" }
  ]
}
